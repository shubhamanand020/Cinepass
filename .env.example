# Cinepass Production Environment Variables Template
# Copy this file to .env and set secure production credentials before deploying:
# cp .env.example .env

# PostgreSQL Production Credentials
POSTGRES_USER=cinepass_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Microservices Database Names
USER_DB_NAME=cinepass_user_db
MOVIE_DB_NAME=cinepass_movie_db
SHOW_DB_NAME=cinepass_show_db
BOOKING_DB_NAME=cinepass_booking_db

# JWT Production Secret (Must match across all microservices)
APP_JWT_SECRET=cinepass-super-secure-production-jwt-key-2026-must-be-min-256-bits

# Service Discovery URL
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
